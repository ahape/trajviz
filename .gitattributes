*          text eol=lf

# Better diffing context?
*.md       text diff=markdown

# These are explicitly windows files and should use crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
# *.ps1    text eol=lf --> PowerShell Core handles LF perfectly fine nowadays

# Archives
*.7z       binary
*.gz       binary
*.tar      binary
*.tgz      binary
*.zip      binary

# Graphics
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tif      binary
*.tiff     binary
*.ico      binary
# *.svg    text eol=lf --> SVG treated as text by default.

# Text files where line endings should be preserved
*.patch    -text
*.diff     -text

# Exclude files from exporting
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore
